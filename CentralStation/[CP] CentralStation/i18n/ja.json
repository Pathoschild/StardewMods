    "location.employee-fridge": "The employees' lunches. It'd be rude to partake.",


    /*********
    ** Tourist dialogue
    *********/
    "tourist.young-boy.1": "やぁ。",
    "tourist.young-boy.2": "ママを待ってるんだ。",
    "tourist.young-boy.3": "知らない人に話しかけちゃいけないんだよ。",

    "tourist.woman-in-black-dress": "いろんな町のお祭り目当てに旅するのが好きなの。仕事の息抜きにもなるしね。",

    "tourist.man-with-drink.1": "旅行のだいごみは食事だよ。",
    "tourist.man-with-drink.2": "フードコートには行ってみた？正直、ほとんど食べられたものじゃない。でも、これも経験だね！",

    "tourist.man-with-sunglasses": "チケット売り場を覗いてみたか？誰がいるのかよくわからないんだ。#あいつら店主も従業員じゃないみたいだ。",

    "tourist.man-with-top-hat.1": "やあ、若いの。金持ちになるひけつを知りたいか？",
    "tourist.man-with-top-hat.2": "一攫千金さ。ギャンブルだよ。カジノではいつも勝つんだ。へへ",

    "tourist.strong-man": "俺みたいに強いって？石を砕いてみろよ！#でもここには石がない。悲しい。",

    "tourist.desert-racer-man.1": "レースに行ってくるよ！",
    "tourist.desert-racer-man.2": "ああ、本当にそうだよ。引退して、ようやくレースイベントを直接見に旅行できるようになったんだ。楽しみだ。",

    "tourist.desert-scholar-man.1": "やあ、友よ！ズズシティに新しい図書館がオープンしたんだ。",
    "tourist.desert-scholar-man.2": "探している本がたくさんあるんだよ。図書館にあるといいんだが。",
    "tourist.desert-scholar-man.3": "もしなくても、きっと新しい本に出会えるよね！",

    "tourist.flamingo.1": "...",
    "tourist.flamingo.2": "...？",
    "tourist.flamingo.3": "*クラクションの音*",
    "tourist.flamingo.4": "（彼女にがっつり無視された。）",

    "tourist.shrouded-figure": "お金を払えば、家まで送ってあげるよ。#まあ、バスに乗ればいいか。",

    "tourist.welwick.1": "私の旧友ラスモディウスと話をしたようだね。",
    "tourist.welwick.2": "あいつの陰謀に巻き込まれていないことを祈るよ。",

    "tourist.cashier-girl.1": "私は長時間立ちっぱなしで仕事をしているの。疲れるし、自分の時間もほとんどないわ。",
    "tourist.cashier-girl.2": "家は好きよ。でも、冒険のない人生なんて考えられる？！",
    "tourist.cashier-girl.3": "無料で行ける場所はたくさんあるの。全部行ってみるつもりよ！",

    "tourist.governor.1": "実に奇妙だな。誰がこの局を運営しているのか誰も知らないんだ。#許可証はすべて提出されたのに、誰もそれを覚えていない。#まあ、このあたりで奇妙なことはこれだけではないがな。",
    "tourist.governor.2": "ようやく自分も電車に乗れるよ。#今度は妻も連れてこよう。",

    "tourist.lupini.1": "こんにちは、若き${男性^女性^人}$よ。私の最新の絵はご覧いただけたかな？", // note for translators: ${...}$ is a gender-switch block which switches between text for male, female, or non-binary players.
    "tourist.lupini.2": "新しいギャラリーを開きに行ってくるよ。よかったら君もおいで。",

    "tourist.red-cap-guy.1": "旅行の素晴らしさは、様々な人々とファッションに出会えることさ。",
    "tourist.red-cap-guy.2": "みんながこんなに違うと、着飾りすぎてるなんて感じないよ！",

    "tourist.shorts-man": "ここ、やたらと寒いな。#ギフトショップで防寒具を買おうか...",

    "tourist.red-pirate": "（彼は飲み物に夢中で、あなたに気づかない。）",

    "tourist.grim-pirate": "あの線路から聞こえてくるのは、ぞっとするような物語...#駅の奥深くで聞こえたアナウンス...#ああ、電車を逃しちまった。",

    "tourist.blackgull-pirate.1": "おおっと、みんなはどこだ？",
    "tourist.blackgull-pirate.2": "もうすぐ乗船の時間だぞ...",

    // TODO
    "tourist.bag-dog.1": "(She's on an adventure.)",
